  "fixed_sql": [
    {
      "name": "habits",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"habits\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"color\" TEXT NOT NULL, \"icon\" TEXT NOT NULL, \"goal\" REAL NOT NULL, \"step\" REAL NOT NULL, \"unit\" TEXT NULL, \"schedule_mode\" TEXT NOT NULL, \"active_days\" INTEGER NOT NULL, \"times_per_week\" INTEGER NOT NULL, \"moment\" TEXT NOT NULL, \"reminders\" TEXT NOT NULL, \"streak_danger_alert\" INTEGER NOT NULL CHECK (\"streak_danger_alert\" IN (0, 1)), \"created_on\" INTEGER NOT NULL, \"archived_on\" INTEGER NULL, \"position\" INTEGER NOT NULL DEFAULT 0);"
        }
      ]
    },
    {
      "name": "pauses",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"pauses\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"habit_id\" INTEGER NOT NULL REFERENCES habits (id) ON DELETE CASCADE, \"from_day\" INTEGER NOT NULL, \"to_day\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"entries\" (\"habit_id\" INTEGER NOT NULL REFERENCES habits (id) ON DELETE CASCADE, \"day\" INTEGER NOT NULL, \"value\" REAL NOT NULL, \"note\" TEXT NULL, \"mood\" INTEGER NULL, PRIMARY KEY (\"habit_id\", \"day\"));"
        }
      ]
    },
    {
      "name": "joker_days",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"joker_days\" (\"day\" INTEGER NOT NULL, PRIMARY KEY (\"day\"));"
        }
      ]
    },
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    }
  ]
